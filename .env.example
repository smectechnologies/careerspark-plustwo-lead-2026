# ── CareerSpark Environment Variables ───────────────────────────
#
# Copy this file to .env (local dev) or .env.production (build).
# Never commit .env or .env.production to version control.
#
# PUBLIC_WEBHOOK_URL
#   The deployed Google Apps Script Web App URL.
#   Get it from: Apps Script → Deploy → Manage Deployments → Web App URL
#
PUBLIC_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbz0o4tARZZk4ov_WnS6Q3uIqQ46j3btyG6uLzKnnfe28MbXlRthL0hAeO7h-XJ8BPrU/exec

# Optional: override the canonical site URL used by the sitemap
# SITE=https://careerspark.example.com

# Microsoft Clarity project ID
# Get it from: clarity.microsoft.com → Settings → Overview → Project ID
PUBLIC_CLARITY_ID=YOUR_CLARITY_PROJECT_ID

# Facebook Pixel ID
# Get it from: business.facebook.com → Events Manager → Pixel → Settings
PUBLIC_FB_PIXEL_ID=YOUR_FB_PIXEL_ID

# Google Analytics Measurement ID
# Get it from: analytics.google.com → Admin → Data Streams → Measurement ID
PUBLIC_GA_ID=YOUR_GA_ID
