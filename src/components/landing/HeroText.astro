---
/**
 * HeroText.astro
 * Renders the landing screen hero heading and sub-heading.
 *
 * Requirements: 2.2, 2.3
 * - Req 2.2: Display the heading "Discover Your Perfect Career Path".
 * - Req 2.3: Display the sub-heading "Answer a few questions and get instant course recommendations."
 */
---

<div class="hero-text">
  <h1 class="hero-heading">No more tensions!
+2 passed or failed</h1>
  <p class="hero-subheading">
    Answer a few questions and get instant course recommendations.
  </p>
</div>

<style>
  .hero-text {
    text-align: center;
    padding: 0 12px;
    margin-bottom: 10px;
  }

  .hero-heading {
    font-family: var(--font-sans);
    font-size: var(--font-size-xl);
    font-weight: 800;
    line-height: 1.3;
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .hero-subheading {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (min-width: 431px) {
    .hero-text {
      padding: 0 24px;
      margin-bottom: 14px;
    }
    .hero-heading {
      font-size: var(--font-size-3xl);
      margin-bottom: 10px;
    }
    .hero-subheading {
      font-size: var(--font-size-base);
      line-height: 1.65;
    }
  }
</style>
