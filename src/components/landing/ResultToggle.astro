---
// ResultToggle.astro — compact 3-position neon toggle switch with 3D depth
---

<div class="toggle-section">

  <p class="toggle-label-text">What's your Plus Two result?</p>

  <div
    class="switch-track"
    role="group"
    aria-label="Select your Plus Two result"
    id="switch-track"
    data-state="none"
  >
    <!-- 3D sliding thumb -->
    <span class="switch-thumb" id="switch-thumb" aria-hidden="true"></span>

    <!-- Passed button -->
    <button
      class="switch-option switch-option--passed"
      id="node-passed"
      type="button"
      aria-pressed="false"
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="opt-icon">
        <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Passed
    </button>

    <!-- Center divider -->
    <span class="switch-divider" aria-hidden="true">
      <span class="divider-dot"></span>
    </span>

    <!-- Not Cleared button -->
    <button
      class="switch-option switch-option--failed"
      id="node-failed"
      type="button"
      aria-pressed="false"
    >
      Not Cleared
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="opt-icon">
        <path d="M8 3.5v5M8 11.5v.5" stroke="currentColor" stroke-width="2"
          stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Status pill -->
  <span class="switch-status" id="switch-status" aria-live="polite">
    <span class="status-dot"></span>
    <span id="status-text">Select your result</span>
  </span>

</div>

<style>
  .toggle-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 8px 0 14px;
  }

  .toggle-label-text {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ══════════════════════════════════════════════
     TRACK — 3D inset pill
  ══════════════════════════════════════════════ */
  .switch-track {
    position: relative;
    display: flex;
    align-items: center;
    width: 280px;
    height: 36px;
    border-radius: 9999px;
    padding: 3px;
    /* deep purple-violet glass */
    background: linear-gradient(180deg, #1A0A3A 0%, #2D1060 100%);
    border: 1.5px solid rgba(160, 80, 255, 0.50);
    box-shadow:
      /* deep inset — track is sunken INTO the screen */
      inset 0 3px 10px rgba(0, 0, 0, 0.70),
      inset 0 1px 3px rgba(0, 0, 0, 0.90),
      inset 0 -1px 0 rgba(255, 255, 255, 0.04),
      /* outer raised edge highlight */
      0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 14px rgba(120, 40, 220, 0.22);
    transition: border-color 300ms ease, box-shadow 300ms ease;
    overflow: hidden;
  }

  /* track border glow on active */
  .switch-track[data-state="passed"] {
    border-color: rgba(0, 255, 240, 0.70);
    box-shadow:
      inset 0 2px 6px rgba(0, 0, 0, 0.50),
      inset 0 1px 0 rgba(0, 255, 240, 0.14),
      0 0 20px rgba(0, 255, 240, 0.32);
  }

  .switch-track[data-state="failed"] {
    border-color: rgba(255, 165, 0, 0.70);
    box-shadow:
      inset 0 2px 6px rgba(0, 0, 0, 0.50),
      inset 0 1px 0 rgba(255, 165, 0, 0.14),
      0 0 20px rgba(255, 165, 0, 0.32);
  }

  /* ══════════════════════════════════════════════
     THUMB — raised 3D pill
  ══════════════════════════════════════════════ */
  .switch-thumb {
    position: absolute;
    top: 3px;
    left: calc(50% - 15px);
    width: 30px;
    height: 28px;
    border-radius: 9999px;
    z-index: 2;
    pointer-events: none;
    /* default: bright cyan raised pill */
    background: linear-gradient(160deg, #80FFEE 0%, #00E5D4 40%, #00BFFF 100%);
    border: 1px solid rgba(0, 255, 240, 0.9);
    /* deep multi-layer shadow = projects out of screen */
    box-shadow:
      /* top highlight — light source from above */
      inset 0 2px 3px rgba(255, 255, 255, 0.55),
      /* bottom inner shadow — depth */
      inset 0 -2px 4px rgba(0, 100, 140, 0.40),
      /* close drop shadow */
      0 4px 6px rgba(0, 0, 0, 0.55),
      /* mid drop shadow */
      0 8px 16px rgba(0, 0, 0, 0.40),
      /* far ambient shadow */
      0 14px 28px rgba(0, 0, 0, 0.25),
      /* neon glow */
      0 0 12px rgba(0, 255, 240, 0.60),
      0 0 28px rgba(0, 255, 240, 0.25);
    transition:
      left 360ms cubic-bezier(0.34, 1.45, 0.64, 1),
      background 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease,
      transform 300ms ease;
  }

  /* thumb → PASSED (left) — electric blue projected */
  .switch-track[data-state="passed"] .switch-thumb {
    left: 3px;
    background: linear-gradient(160deg, #80E8FF 0%, #00C8FF 40%, #0090CC 100%);
    border-color: #00CFFF;
    transform: translateY(-2px) scale(1.06);
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.55),
      inset 0 -2px 4px rgba(0, 60, 120, 0.40),
      0 6px 10px rgba(0, 0, 0, 0.55),
      0 12px 24px rgba(0, 0, 0, 0.35),
      0 20px 40px rgba(0, 0, 0, 0.20),
      0 0 16px rgba(0, 191, 255, 0.80),
      0 0 36px rgba(0, 191, 255, 0.35);
  }

  /* thumb → NOT CLEARED (right) — amber projected */
  .switch-track[data-state="failed"] .switch-thumb {
    left: calc(100% - 33px);
    background: linear-gradient(160deg, #FFE880 0%, #FFB800 40%, #E07000 100%);
    border-color: #FFB800;
    transform: translateY(-2px) scale(1.06);
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.55),
      inset 0 -2px 4px rgba(140, 60, 0, 0.40),
      0 6px 10px rgba(0, 0, 0, 0.55),
      0 12px 24px rgba(0, 0, 0, 0.35),
      0 20px 40px rgba(0, 0, 0, 0.20),
      0 0 16px rgba(255, 165, 0, 0.80),
      0 0 36px rgba(255, 165, 0, 0.35);
  }

  /* ══════════════════════════════════════════════
     OPTION BUTTONS
  ══════════════════════════════════════════════ */
  .switch-option {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: rgba(255,255,255,0.35);
    border-radius: 9999px;
    padding: 0 4px;
    transition: color 280ms ease, text-shadow 280ms ease;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .switch-option:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }
  .switch-option:focus:not(:focus-visible) { outline: none; }

  .opt-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  /* active label colours */
  .switch-track[data-state="passed"] .switch-option--passed {
    color: #fff;
    text-shadow: 0 0 10px rgba(0, 191, 255, 1), 0 0 20px rgba(0, 191, 255, 0.6);
  }

  .switch-track[data-state="failed"] .switch-option--failed {
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 165, 0, 1), 0 0 20px rgba(255, 165, 0, 0.6);
  }

  /* ── Center divider ───────────────────────────────────────── */
  .switch-divider {
    position: relative;
    z-index: 3;
    width: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .divider-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.18);
    box-shadow: 0 0 4px rgba(255,255,255,0.1);
    transition: opacity 250ms ease;
  }

  .switch-track[data-state="passed"] .divider-dot,
  .switch-track[data-state="failed"] .divider-dot {
    opacity: 0;
  }

  /* ══════════════════════════════════════════════
     STATUS PILL
  ══════════════════════════════════════════════ */
  .switch-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 8px;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--color-text-muted);
    transition: background 280ms ease, border-color 280ms ease, color 280ms ease;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text-muted);
    flex-shrink: 0;
    transition: background 280ms ease, box-shadow 280ms ease;
  }

  /* status — passed */
  .switch-track[data-state="passed"] ~ .switch-status {
    background: rgba(0, 191, 255, 0.10);
    border-color: rgba(0, 191, 255, 0.40);
    color: #00BFFF;
  }
  .switch-track[data-state="passed"] ~ .switch-status .status-dot {
    background: #00BFFF;
    box-shadow: 0 0 6px rgba(0, 191, 255, 1), 0 0 12px rgba(0, 191, 255, 0.5);
    animation: dot-ping 1.4s ease-out infinite;
  }

  /* status — failed */
  .switch-track[data-state="failed"] ~ .switch-status {
    background: rgba(255, 165, 0, 0.10);
    border-color: rgba(255, 165, 0, 0.40);
    color: #FFA500;
  }
  .switch-track[data-state="failed"] ~ .switch-status .status-dot {
    background: #FFA500;
    box-shadow: 0 0 6px rgba(255, 165, 0, 1), 0 0 12px rgba(255, 165, 0, 0.5);
    animation: dot-ping 1.4s ease-out infinite;
  }

  @keyframes dot-ping {
    0%   { transform: scale(1);   opacity: 1; }
    60%  { transform: scale(1.8); opacity: 0.4; }
    100% { transform: scale(1);   opacity: 1; }
  }

  /* ── Desktop ──────────────────────────────────────────────── */
  @media (min-width: 431px) {
    .toggle-section    { gap: 12px; padding: 12px 0 18px; }
    .toggle-label-text { font-size: 0.72rem; }
    .switch-track      { width: 300px; height: 40px; padding: 4px; }
    .switch-thumb      { width: 34px; height: 30px; top: 4px; }
    .switch-track[data-state="passed"] .switch-thumb  { left: 4px; }
    .switch-track[data-state="failed"] .switch-thumb  { left: calc(100% - 38px); }
    .switch-option     { font-size: 0.76rem; gap: 5px; }
    .opt-icon          { width: 13px; height: 13px; }
  }
</style>

<script>
  const track      = document.getElementById('switch-track')  as HTMLElement | null;
  const nodePassed = document.getElementById('node-passed')   as HTMLButtonElement | null;
  const nodeFailed = document.getElementById('node-failed')   as HTMLButtonElement | null;
  const statusText = document.getElementById('status-text')   as HTMLElement | null;

  type State = 'none' | 'passed' | 'failed';
  let current: State = 'none';

  const LABELS: Record<State, string> = {
    none:   'Select your result',
    passed: 'Plus Two Passed',
    failed: 'Not Cleared',
  };

  function setState(next: State): void {
    if (next === current) next = 'none';
    current = next;

    if (track) track.dataset.state = next;
    nodePassed?.setAttribute('aria-pressed', String(next === 'passed'));
    nodeFailed?.setAttribute('aria-pressed', String(next === 'failed'));
    if (statusText) statusText.textContent = LABELS[next];

    window.dispatchEvent(
      new CustomEvent('result-toggle-change', { detail: next, bubbles: true })
    );
  }

  nodePassed?.addEventListener('click', () => setState('passed'));
  nodeFailed?.addEventListener('click', () => setState('failed'));
</script>
