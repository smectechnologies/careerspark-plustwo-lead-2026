---
// ResultToggle.astro — two stylish neon choice buttons
---

<div class="toggle-section">

  <p class="toggle-label-text">What's your Plus Two result?</p>

  <div class="choice-buttons" role="group" aria-label="Select your Plus Two result">

    <!-- PASSED button -->
    <button
      class="choice-btn choice-btn--passed"
      id="node-passed"
      type="button"
      aria-pressed="false"
    >
      <span class="choice-btn__bg" aria-hidden="true"></span>
      <span class="choice-btn__glow" aria-hidden="true"></span>
      <span class="choice-btn__content">
        <span class="choice-btn__icon" aria-hidden="true">
          <svg viewBox="0 0 22 22" fill="none">
            <circle cx="11" cy="11" r="9.5" stroke="currentColor" stroke-width="1.8"/>
            <path d="M6.5 11l3 3 6-6" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="choice-btn__text">
          <span class="choice-btn__label">Passed</span>
          <span class="choice-btn__sub">Plus Two Cleared</span>
        </span>
      </span>
    </button>

    <!-- NOT CLEARED button -->
    <button
      class="choice-btn choice-btn--failed"
      id="node-failed"
      type="button"
      aria-pressed="false"
    >
      <span class="choice-btn__bg" aria-hidden="true"></span>
      <span class="choice-btn__glow" aria-hidden="true"></span>
      <span class="choice-btn__content">
        <span class="choice-btn__icon" aria-hidden="true">
          <svg viewBox="0 0 22 22" fill="none">
            <circle cx="11" cy="11" r="9.5" stroke="currentColor" stroke-width="1.8"/>
            <path d="M11 7v5M11 15v.5" stroke="currentColor" stroke-width="2"
              stroke-linecap="round"/>
          </svg>
        </span>
        <span class="choice-btn__text">
          <span class="choice-btn__label">Not Cleared</span>
          <span class="choice-btn__sub">Still a great path ahead</span>
        </span>
      </span>
    </button>

  </div>

</div>

<style>
  /* ── Section ──────────────────────────────────────────────── */
  .toggle-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 8px 0 14px;
  }

  .toggle-label-text {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ── Button grid ──────────────────────────────────────────── */
  .choice-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
  }

/* ── Base button ──────────────────────────────────────────── */
.choice-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px 4px;
  border-radius: 10px;
  border: 1.5px solid rgba(255, 255, 255, 0.10);
  background: transparent;
  cursor: pointer;
  font-family: var(--font-sans);
  overflow: hidden;
  transition:
    transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
    border-color 250ms ease,
    box-shadow 250ms ease;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}
   
/* Not active state */
.choice-btn[aria-pressed="false"] {
  opacity: 0.7;
}

.choice-btn[aria-pressed="false"] .choice-btn__bg {
  background: linear-gradient(160deg, rgba(0, 191, 255, 0.774) 0%, rgba(168, 255, 114, 0.842) 100%);
}

  .choice-btn:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 3px;
  }
  .choice-btn:focus:not(:focus-visible) { outline: none; }

  /* dark glass background layer */
  .choice-btn__bg {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(160deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 250ms ease;
  }

  /* glow layer — hidden until active */
  .choice-btn__glow {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  /* content row */
  .choice-btn__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
  }

/* icon circle */
.choice-btn__icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(255, 255, 255);
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: var(--color-text-muted);
  transition: background 250ms ease, border-color 250ms ease,
              color 250ms ease, box-shadow 250ms ease;
}

.choice-btn__icon svg {
  width: 14px;
  height: 14px;
}

/* text stack */
   .choice-btn__text {
     display: flex;
     flex-direction: column;
     align-items: flex-start;
     gap: 2px;
   }

   .choice-btn__label {
     font-size: 0.8rem;
     font-weight: 800;
     letter-spacing: 0.01em;
     color: rgb(255, 255, 255);
     line-height: 1;
     transition: color 250ms ease, text-shadow 250ms ease;
   }

   .choice-btn__sub {
     font-size: 0.56rem;
     font-weight: 500;
     letter-spacing: 0.03em;
     color: rgb(255, 255, 255);
     line-height: 1.2;
     transition: color 250ms ease;
   }

  /* hover — both buttons */
  .choice-btn:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .choice-btn:hover .choice-btn__bg {
    background: linear-gradient(160deg, rgba(255,255,255,0.09) 0%, rgba(255,255,255,0.04) 100%);
  }

  /* ══════════════════════════════════════════════
     PASSED — active  (#00FFF0 cyan)
  ══════════════════════════════════════════════ */
  .choice-btn--passed[aria-pressed="true"] {
    border-color: #00FFF0;
    transform: translateY(-3px) scale(1.03);
    box-shadow:
      0 0 0 1px rgba(0, 255, 240, 0.40),
      0 8px 24px rgba(0, 255, 240, 0.20),
      0 2px 8px rgba(0, 0, 0, 0.40);
  }

  .choice-btn--passed[aria-pressed="true"] .choice-btn__bg {
    background: linear-gradient(160deg, rgba(0,255,240,0.14) 0%, rgba(0,191,255,0.06) 100%);
  }

  .choice-btn--passed[aria-pressed="true"] .choice-btn__glow {
    background: radial-gradient(ellipse at 50% 0%, rgba(0,255,240,0.22) 0%, transparent 65%);
    opacity: 1;
  }

  .choice-btn--passed[aria-pressed="true"] .choice-btn__icon {
    background: rgba(0, 255, 240, 0.18);
    border-color: rgba(0, 255, 240, 0.55);
    color: #00FFF0;
    box-shadow: 0 0 14px rgba(0, 255, 240, 0.50);
  }

  .choice-btn--passed[aria-pressed="true"] .choice-btn__label {
    color: #00FFF0;
    text-shadow: 0 0 12px rgba(0, 255, 240, 0.80);
  }

  .choice-btn--passed[aria-pressed="true"] .choice-btn__sub {
    color: rgba(0, 255, 240, 0.70);
  }

  /* ══════════════════════════════════════════════
     NOT CLEARED — active  (#FFB800 amber)
  ══════════════════════════════════════════════ */
  .choice-btn--failed[aria-pressed="true"] {
    border-color: #FFB800;
    transform: translateY(-3px) scale(1.03);
    box-shadow:
      0 0 0 1px rgba(255, 184, 0, 0.40),
      0 8px 24px rgba(255, 184, 0, 0.20),
      0 2px 8px rgba(0, 0, 0, 0.40);
  }

  .choice-btn--failed[aria-pressed="true"] .choice-btn__bg {
    background: linear-gradient(160deg, rgba(255,184,0,0.14) 0%, rgba(255,120,0,0.06) 100%);
  }

  .choice-btn--failed[aria-pressed="true"] .choice-btn__glow {
    background: radial-gradient(ellipse at 50% 0%, rgba(255,184,0,0.22) 0%, transparent 65%);
    opacity: 1;
  }

  .choice-btn--failed[aria-pressed="true"] .choice-btn__icon {
    background: rgba(255, 184, 0, 0.18);
    border-color: rgba(255, 184, 0, 0.55);
    color: #FFB800;
    box-shadow: 0 0 14px rgba(255, 184, 0, 0.50);
  }

  .choice-btn--failed[aria-pressed="true"] .choice-btn__label {
    color: #FFB800;
    text-shadow: 0 0 12px rgba(255, 184, 0, 0.80);
  }

  .choice-btn--failed[aria-pressed="true"] .choice-btn__sub {
    color: rgba(255, 184, 0, 0.70);
  }

/* ── Desktop ──────────────────────────────────────────────── */
@media (min-width: 431px) {
  .toggle-section    { gap: 14px; padding: 12px 0 18px; }
  .toggle-label-text { font-size: 0.74rem; }
  .choice-buttons    { gap: 12px; }
  .choice-btn        { padding: 10px 8px; border-radius: 14px; }
  .choice-btn__icon  { width: 32px; height: 32px; }
  .choice-btn__icon svg { width: 16px; height: 16px; }
  .choice-btn__label { font-size: 0.88rem; }
  .choice-btn__sub   { font-size: 0.6rem; }
}
</style>

<script>
  const nodePassed = document.getElementById('node-passed') as HTMLButtonElement | null;
  const nodeFailed = document.getElementById('node-failed') as HTMLButtonElement | null;

  type State = 'none' | 'passed' | 'failed';
  let current: State = 'none';

  function setState(next: State): void {
    if (next === current) next = 'none';
    current = next;

    nodePassed?.setAttribute('aria-pressed', String(next === 'passed'));
    nodeFailed?.setAttribute('aria-pressed', String(next === 'failed'));

    window.dispatchEvent(
      new CustomEvent('result-toggle-change', { detail: next, bubbles: true })
    );
  }

  nodePassed?.addEventListener('click', () => setState('passed'));
  nodeFailed?.addEventListener('click', () => setState('failed'));
</script>
