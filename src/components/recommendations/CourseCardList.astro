---
/**
 * CourseCardList.astro
 * Horizontal swipeable container for course cards on mobile viewports.
 * On desktop it renders as a vertical stack.
 *
 * Requirements: 7.7
 */

import CourseCard from './CourseCard.astro';

interface Props {
  courses: Array<{
    id: string;
    name: string;
    duration: string;
    eligibility: string;
    careerDescription: string;
    exploreUrl: string;
  }>;
}

const { courses } = Astro.props;
---

<div class="course-card-list" role="list" aria-label="Recommended courses">
  {courses.map((course) => (
    <div class="course-card-list__item" role="listitem">
      <CourseCard
        id={course.id}
        name={course.name}
        duration={course.duration}
        eligibility={course.eligibility}
        careerDescription={course.careerDescription}
        exploreUrl={course.exploreUrl}
      />
    </div>
  ))}
</div>

<style>
  /* ── Mobile: horizontal scroll carousel ────────────────────── */
  @media (max-width: 430px) {
    .course-card-list {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: var(--space-md);
      /* Padding so first/last card isn't flush against the edge */
      padding-inline: var(--space-md);
      padding-block: var(--space-sm);
      /* Hide scrollbar visually while keeping scroll functionality */
      scrollbar-width: none;        /* Firefox */
      -ms-overflow-style: none;     /* IE / Edge legacy */
    }

    .course-card-list::-webkit-scrollbar {
      display: none;                /* Chrome / Safari / WebKit */
    }

    .course-card-list__item {
      scroll-snap-align: start;
      flex-shrink: 0;
      width: 85%;
    }
  }

  /* ── Desktop: vertical stack ────────────────────────────────── */
  @media (min-width: 431px) {
    .course-card-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
      padding-block: var(--space-sm);
    }

    .course-card-list__item {
      width: 100%;
    }
  }
</style>

<script>
  /**
   * Touch swipe support for the horizontal course card carousel.
   * Requirements: 7.7
   *
   * - Swipe left  → scroll right by one card width
   * - Swipe right → scroll left  by one card width
   * Minimum swipe distance of 40px prevents accidental triggers.
   */
  (function () {
    const SWIPE_THRESHOLD = 40; // px

    document.querySelectorAll<HTMLElement>('.course-card-list').forEach((list) => {
      let touchStartX = 0;
      let touchStartY = 0;

      list.addEventListener(
        'touchstart',
        (e: TouchEvent) => {
          touchStartX = e.changedTouches[0].clientX;
          touchStartY = e.changedTouches[0].clientY;
        },
        { passive: true }
      );

      list.addEventListener(
        'touchend',
        (e: TouchEvent) => {
          const deltaX = e.changedTouches[0].clientX - touchStartX;
          const deltaY = e.changedTouches[0].clientY - touchStartY;

          // Ignore if the gesture is more vertical than horizontal
          if (Math.abs(deltaY) > Math.abs(deltaX)) return;
          // Ignore tiny movements
          if (Math.abs(deltaX) < SWIPE_THRESHOLD) return;

          // Determine card width from the first item (includes gap)
          const firstItem = list.querySelector<HTMLElement>('.course-card-list__item');
          const cardWidth = firstItem
            ? firstItem.offsetWidth + parseInt(getComputedStyle(list).gap || '0', 10)
            : list.offsetWidth;

          if (deltaX < 0) {
            // Swipe left → scroll right
            list.scrollBy({ left: cardWidth, behavior: 'smooth' });
          } else {
            // Swipe right → scroll left
            list.scrollBy({ left: -cardWidth, behavior: 'smooth' });
          }
        },
        { passive: true }
      );
    });
  })();
</script>
