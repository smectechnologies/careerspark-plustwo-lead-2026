---
import '../styles/global.css';
import MobileShell from '../components/layout/MobileShell.astro';
import ParticleBackground from '../components/layout/ParticleBackground.astro';
import Logo from '../components/landing/Logo.astro';
import HeroText from '../components/landing/HeroText.astro';
import ResultToggle from '../components/landing/ResultToggle.astro';
import PassedForm from '../components/forms/PassedForm.astro';
import FailedForm from '../components/forms/FailedForm.astro';
import SuccessScreen from '../components/recommendations/SuccessScreen.astro';
import InstallPrompt from '../components/pwa/InstallPrompt.astro';

const clarityId  = import.meta.env.PUBLIC_CLARITY_ID;
const pixelId    = import.meta.env.PUBLIC_FB_PIXEL_ID;
const gaId       = import.meta.env.PUBLIC_GA_ID;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>CareerSpark – Plus Two Passed or Not Cleared? Find Your Best Course Now</title>
    <meta name="description" content="CareerSpark helps Plus Two students discover the best courses based on their marks and subjects. Know which course to choose, how fast you can get a job, and what salary to expect — instantly." />
    <meta name="keywords" content="plus two course finder, career after plus two, course recommendations Kerala, plus two passed courses, plus two not cleared options, career guidance students" />
    <meta name="author" content="CareerSpark" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph (Facebook / WhatsApp / LinkedIn) -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="CareerSpark" />
    <meta property="og:title"       content="CareerSpark – Find Your Perfect Course After Plus Two" />
    <meta property="og:description" content="Passed or not cleared? Enter your marks and subjects — CareerSpark instantly shows the best courses for you, how soon you can get a job, and your expected starting salary." />
    <meta property="og:image"       content="/logo.png" />
    <meta property="og:image:width"  content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt"   content="CareerSpark logo" />
    <meta property="og:url"         content={Astro.url.href} />
    <meta property="og:locale"      content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary" />
    <meta name="twitter:title"       content="CareerSpark – Find Your Perfect Course After Plus Two" />
    <meta name="twitter:description" content="Passed or not cleared? Get instant personalised course recommendations based on your Plus Two marks and subjects." />
    <meta name="twitter:image"       content="/logo.png" />
    <meta name="twitter:image:alt"   content="CareerSpark logo" />

    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#081229" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#081229" media="(prefers-color-scheme: light)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CareerSpark" />

    <!-- Microsoft Clarity -->
    {clarityId && clarityId !== 'YOUR_CLARITY_PROJECT_ID' && (
      <script is:inline define:vars={{ clarityId }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window,document,"clarity","script",clarityId);
      </script>
    )}
  </head>
  <body>
    <div id="app-loader" class="app-loader" role="status" aria-live="polite">
      <span class="app-loader__spinner" aria-hidden="true"></span>
      <span class="sr-only">Loading CareerSpark</span>
    </div>

    <MobileShell>
      <ParticleBackground />

      <main id="app" class="app-content">
        <section id="intake-screen" class="intake-screen" aria-label="CareerSpark lead form">
          <Logo />
          <HeroText />
          <ResultToggle />

          <!-- Hero image — visible on load, collapses when toggle selected -->
          <div id="hero-image-wrap" class="hero-image-wrap" aria-hidden="true">
            <div class="hero-image-inner">
              <img
                src="/hero.webp"
                alt=""
                class="hero-image"
                draggable="false"
                fetchpriority="high"
                width="430"
                height="220"
              />
            </div>
          </div>

          <!-- Malayalam tagline — collapses with hero image -->
          <div id="hero-tagline" class="hero-tagline" lang="ml">
            <p>
              നിങ്ങളുടെ മാർക്ക്, പഠിച്ച സബ്ജക്ട്സ് തുടങ്ങിയ വിവരങ്ങൾ വച്ച്
              <strong>നിങ്ങൾക്കിനി ഏതൊക്കെ കോഴ്സ് തിരഞ്ഞെടുക്കാം</strong>,
              പഠിച്ചു കഴിഞ്ഞാൽ
              <strong>എത്രനാൾ കൊണ്ട് ജോലി നേടാം</strong>,
              തുടക്കത്തിൽ
              <strong>എത്ര ശമ്പളം കിട്ടും</strong>
              എന്നൊക്കെ കൃത്യമായി മനസ്സിലാക്കാം.
            </p>
          </div>

          <div id="form-panels-wrap" class="form-panels-wrap">
            <div class="form-panels">
              <div id="passed-panel" class="form-panel" hidden>
                <PassedForm />
              </div>
              <div id="failed-panel" class="form-panel" hidden>
                <FailedForm />
              </div>
            </div>
          </div>
        </section>

        <SuccessScreen />
      </main>

      <InstallPrompt />
    </MobileShell>

    <!-- Facebook Pixel -->
    {pixelId && pixelId !== 'YOUR_FB_PIXEL_ID' && (
      <script is:inline define:vars={{ pixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f['_fbq'])f['_fbq']=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
        (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Google Analytics -->
    {gaId && gaId !== 'YOUR_GA_ID' && (
      <script is:inline define:vars={{ gaId }}>
        (function(){
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        })();
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}

    <script>
      import { captureUtmParams } from '../lib/utmTracker';
      import { trackLead } from '../lib/analytics';

      const passedPanel    = document.getElementById('passed-panel')    as HTMLDivElement | null;
      const failedPanel    = document.getElementById('failed-panel')    as HTMLDivElement | null;
      const intakeScreen   = document.getElementById('intake-screen')   as HTMLElement    | null;
      const resultToggle   = document.querySelector<HTMLElement>('.toggle-section');
      const loader         = document.getElementById('app-loader')      as HTMLDivElement | null;
      const heroWrap       = document.getElementById('hero-image-wrap') as HTMLDivElement | null;
      const heroTagline    = document.getElementById('hero-tagline')    as HTMLDivElement | null;
      const formPanelsWrap = document.getElementById('form-panels-wrap') as HTMLDivElement | null;

      captureUtmParams(new URL(window.location.href));

      let heroVisible = true;

      function hideHero(): void {
        if (!heroWrap || !heroVisible) return;
        heroVisible = false;
        heroWrap.classList.add('hero-collapsing');
        if (heroTagline) heroTagline.classList.add('hero-collapsing');
        // After transition ends, fully remove from flow
        heroWrap.addEventListener('transitionend', () => {
          heroWrap.classList.add('hero-gone');
          heroWrap.classList.remove('hero-collapsing');
          if (heroTagline) {
            heroTagline.classList.add('hero-gone');
            heroTagline.classList.remove('hero-collapsing');
          }
        }, { once: true });
      }

      function showHero(): void {
        if (!heroWrap || heroVisible) return;
        heroVisible = true;
        heroWrap.classList.remove('hero-gone');
        if (heroTagline) heroTagline.classList.remove('hero-gone');
        // Force reflow so transition plays from collapsed state
        void heroWrap.offsetHeight;
        heroWrap.classList.remove('hero-collapsing');
        if (heroTagline) heroTagline.classList.remove('hero-collapsing');
      }

      function showPanel(panel: HTMLDivElement): void {
        panel.hidden = false;
        // Force reflow so animation replays
        panel.classList.remove('form-panel');
        void panel.offsetWidth;
        panel.classList.add('form-panel');
      }

      window.addEventListener('result-toggle-change', (event: Event) => {
        const result = (event as CustomEvent<'passed' | 'failed' | 'none'>).detail;
        if (!passedPanel || !failedPanel) return;

        if (result === 'passed') {
          hideHero();
          failedPanel.hidden = true;
          showPanel(passedPanel);
        } else if (result === 'failed') {
          hideHero();
          passedPanel.hidden = true;
          showPanel(failedPanel);
        } else {
          // Deselected — show hero, hide forms
          showHero();
          passedPanel.hidden = true;
          failedPanel.hidden = true;
        }
      });

      window.addEventListener('show-success-screen', () => {
        if (intakeScreen) intakeScreen.hidden = true;
        trackLead();
      });

      window.addEventListener('passed-subject-step-active', () => {
        if (resultToggle) resultToggle.hidden = true;
      });

      window.addEventListener('passed-subject-step-back', () => {
        if (resultToggle) resultToggle.hidden = false;
      });

      window.addEventListener('load', () => {
        if (!loader) return;
        loader.classList.add('app-loader--hidden');
        window.setTimeout(() => loader.remove(), 250);
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js')
            .catch((error) => console.warn('Service worker registration failed', error));
        });
      }
    </script>
  </body>
</html>

<style>
  .app-loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    transition: opacity 200ms ease, visibility 200ms ease;
  }

  .app-loader--hidden {
    opacity: 0;
    visibility: hidden;
  }

  .app-loader__spinner {
    width: 42px;
    height: 42px;
    border: 3px solid rgba(124, 58, 237, 0.2);
    border-top-color: var(--color-secondary);
    border-radius: 50%;
    animation: app-loader-spin 800ms linear infinite;
  }

  @keyframes app-loader-spin {
    to { transform: rotate(360deg); }
  }

  .app-content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    overflow-y: auto;
  }

  .intake-screen {
    position: relative;
    z-index: 1;
    min-height: 100%;
    padding: 0 20px 48px;   /* mobile: 20px sides, 48px bottom */
  }

  .intake-screen[hidden] { display: none; }

  /* ════════════════════════════════════════════════════════
     HERO IMAGE — smooth height collapse + fade out
  ════════════════════════════════════════════════════════ */

  .hero-image-wrap {
    display: grid;
    grid-template-rows: 1fr;
    margin-top: 18px;
    transition:
      grid-template-rows 480ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity            380ms cubic-bezier(0.4, 0, 0.2, 1),
      margin-top         480ms cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 1;
  }

  .hero-image-wrap.hero-collapsing {
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: 0;
  }

  .hero-image-wrap.hero-gone {
    display: none;
  }

  .hero-image-inner {
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(0, 191, 255, 0.25);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .hero-image {
    width: 100%;
    height: 210px;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  /* ════════════════════════════════════════════════════════
     MALAYALAM TAGLINE — collapses with hero image
  ════════════════════════════════════════════════════════ */

  .hero-tagline {
    display: grid;
    grid-template-rows: 1fr;
    margin-top: 14px;
    transition:
      grid-template-rows 480ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity            380ms cubic-bezier(0.4, 0, 0.2, 1),
      margin-top         480ms cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 1;
  }

  .hero-tagline.hero-collapsing {
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: 0;
  }

  .hero-tagline.hero-gone {
    display: none;
  }

  .hero-tagline p {
    overflow: hidden;
    margin: 0;
    padding: 18px 20px;
    background: rgba(0, 191, 255, 0.06);
    border: 1px solid rgba(0, 191, 255, 0.20);
    border-radius: 16px;
    font-size: 0.96rem;
    line-height: 2;
    color: rgba(232, 244, 255, 0.90);
    text-align: center;
  }

  .hero-tagline p strong {
    background: linear-gradient(135deg, #00FFF0 0%, #00BFFF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 800;
  }

  /* ════════════════════════════════════════════════════════
     FORM PANELS — smooth fade + slide up entrance
  ════════════════════════════════════════════════════════ */

  .form-panels-wrap {
    margin-top: 18px;
  }

  .form-panel[hidden] { display: none; }

  .form-panel {
    animation: panel-in 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ── Desktop (> 430px) ───────────────────────────────────── */
  @media (min-width: 431px) {
    .intake-screen        { padding: 0 32px 56px; }
    .hero-image-wrap      { margin-top: 24px; }
    .hero-image-inner     { border-radius: 22px; }
    .hero-image           { height: 240px; }
    .hero-tagline         { margin-top: 16px; }
    .hero-tagline p       { font-size: 1.02rem; padding: 20px 24px; border-radius: 18px; line-height: 2.1; }
    .form-panels-wrap     { margin-top: 24px; }
  }
</style>
